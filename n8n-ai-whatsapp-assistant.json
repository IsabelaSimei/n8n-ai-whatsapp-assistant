        "jsonHeaders": "{\n  \"Content-Type\": \"application/json\",\n  \"Accept\": \"application/json\",\n  \"Authorization\": \"Bearer YOUR_RESPOND_IO_TOKEN_HERE\"\n}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"channelId\": $('Respond.io Trigger').item.json.message.channelId, \"message\": { \"type\": \"text\", \"text\": String($json.output || \"Olá! Como podemos te ajudar hoje?\") } } }}",
